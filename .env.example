# ==============================================================================
# Sentinel Flood-Watch - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform & Vertex AI Config
# ------------------------------------------------------------------------------
# The ID of your active GCP Project (e.g., gen-lang-client-000544566)
GOOGLE_CLOUD_PROJECT=

# The region to deploy to / make Vertex AI calls (e.g., us-central1, global)
GOOGLE_CLOUD_LOCATION=

# Set to True if using Vertex AI natively, False for Gemini API Studio
GOOGLE_GENAI_USE_VERTEXAI=

# Absolute path to your service account JSON key file (for standard Google Cloud SDK authentication)
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# Google Earth Engine (GEE)
# ------------------------------------------------------------------------------
# Absolute path to your GCP service account JSON key file (for local run GEE auth)
# If empty, the system falls back to your local gcloud CLI login or mock imagery.
GEE_SERVICE_ACCOUNT_KEY_PATH=

# ------------------------------------------------------------------------------
# MongoDB Database Configuration
# ------------------------------------------------------------------------------
# Connection string for your MongoDB Atlas cluster or local MongoDB instance
# (e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority)
# If empty, the system automatically falls back to local file-based database ('alerts_db.json')
MONGODB_URI=
MONGODB_DB_NAME=sentinel_flood_watch

# ------------------------------------------------------------------------------
# Arize Telemetry & Observability
# ------------------------------------------------------------------------------
# Credentials for sending traces to Arize cloud (app.arize.com).
# Retrieve your Space ID and API Key from:
# https://app.arize.com/organizations/-/settings/space-api-keys
PHOENIX_PROJECT_NAME=sentinel-flood-watch
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# ------------------------------------------------------------------------------
# Nominatim Geocoding API
# ------------------------------------------------------------------------------
# Email address to include in User-Agent header for OpenStreetMap Nominatim queries.
# Highly recommended by Nominatim's Acceptable Use Policy to avoid IP blocks.
NOMINATIM_EMAIL=

# ------------------------------------------------------------------------------
# Security Configurations
# ------------------------------------------------------------------------------
# Server-side hash salting for IP-based user ID generation
IP_SALT=

